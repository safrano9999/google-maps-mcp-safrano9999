#required: Google Maps Platform API key
#secret
GOOGLE_MAPS_API_KEY=

# Traffic routing for DRIVE and TWO_WHEELER; ignored for other travel modes.
# Values: TRAFFIC_AWARE_OPTIMAL, TRAFFIC_AWARE, TRAFFIC_UNAWARE
#default-preset: TRAFFIC_AWARE_OPTIMAL
GOOGLE_MAPS_ROUTING_PREFERENCE=TRAFFIC_AWARE_OPTIMAL
